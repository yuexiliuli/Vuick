<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SDCB_ROOT 注入：env 优先，缺省 E:\Rust\SimdCodecs（相对本目录上溯 4 级） -->
    <SDCB_ROOT Condition="'$(SDCB_ROOT)'==''">$(MSBuildProjectDirectory)\..\..\..\..\SimdCodecs</SDCB_ROOT>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SDCB_ROOT)/src/Sdcb.SimdCodecs.Jpeg/Sdcb.SimdCodecs.Jpeg.csproj" />
  </ItemGroup>

</Project>
